# Copy to server/.env for local development.
DATABASE_URL=postgres://devgrowth:devgrowth@localhost:5433/devgrowth
# Used by `npm test` only. The tests TRUNCATE every table, so never point this at real data.
TEST_DATABASE_URL=postgres://devgrowth:devgrowth@localhost:5433/devgrowth_test
PORT=3000
HOST=127.0.0.1
BCRYPT_ROUNDS=12
# Set to true in production (HTTPS) so the web session cookie is Secure.
COOKIE_SECURE=false
# Folder with the built dashboard (step 4). Served at / when it exists.
WEB_DIST=../web/dist
